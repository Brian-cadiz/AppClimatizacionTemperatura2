<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado y Estado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Heladas"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1F2937" />

        <TextView
            android:id="@+id/tvEstadoConexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado: Conectado a Firebase"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvNodoActivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nodo Activo: Cargando..."
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <!-- Tarjeta de Lectura Principal -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTemperatura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- °C"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#3B82F6" />

                <TextView
                    android:id="@+id/tvHumedad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Humedad: -- %"
                    android:textSize="18sp"
                    android:textColor="#4B5563"
                    android:layout_marginTop="8dp" />

                <!-- Badge de Alerta -->
                <TextView
                    android:id="@+id/tvAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: Esperando datos..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="16dp"
                    android:background="#D1FAE5" />

                <TextView
                    android:id="@+id/tvRele"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relé: INACTIVO"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botones de Acción -->
        <Button
            android:id="@+id/btnAgregarDispositivo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Agregar Dispositivo"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnVerHistorial"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver Historial"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cerrar Sesión"
            android:textColor="#EF4444"
            android:layout_marginTop="10dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>
</ScrollView>